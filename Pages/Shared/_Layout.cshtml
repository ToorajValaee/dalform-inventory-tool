@using Microsoft.AspNetCore.Identity
@using InventoryTool.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>Inventory Tool</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/app.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<div class="phone-shell">
    <header class="top-bar">
        <div>
            <div class="eyebrow">ابزار انبار</div>
            <div class="page-title">@ViewData["Title"]</div>
        </div>

        @if (SignInManager.IsSignedIn(User))
        {
            <form method="post" asp-page="/Account/Logout">
                <button class="icon-btn" type="submit">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>
        }
    </header>

    <main class="content">
        @RenderBody()
    </main>

    @if (SignInManager.IsSignedIn(User))
    {
        <nav class="bottom-nav">
            @if (User.IsInRole("Admin"))
            {
                <a asp-page="/Admin/Index"><i class="bi bi-grid"></i><span>خانه</span></a>
                <a asp-page="/Admin/Products/Index"><i class="bi bi-box-seam"></i><span>کالاها</span></a>
                <a asp-page="/Admin/Users/Index"><i class="bi bi-people"></i><span>کاربران</span></a>
                <a asp-page="/Admin/Reports/Index"><i class="bi bi-file-earmark-spreadsheet"></i><span>گزارشات</span></a>
            }
            else
            {
                <a asp-page="/Employee/Index"><i class="bi bi-house"></i><span>خانه</span></a>
                <a asp-page="/Employee/Report"><i class="bi bi-plus-circle"></i><span>گزارش من</span></a>
                <a asp-page="/Employee/Summary"><i class="bi bi-clock-history"></i><span>خلاصه گزارش</span></a>
            }
        </nav>
    }
</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/css/persian-datepicker.min.css">

<script src="https://cdn.jsdelivr.net/npm/persian-date@1.1.0/dist/persian-date.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/persian-datepicker@1.2.0/dist/js/persian-datepicker.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>