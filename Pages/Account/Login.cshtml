@page
@model InventoryTool.Pages.Account.LoginModel

<div class="app-card mx-auto" style="max-width:420px;margin-top:40px;">
    <h1 class="h3 fw-bold mb-1">خوش آمدید</h1>
    <p class="text-muted mb-4">برای مدیرت کالا، وارد شوید..</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger rounded-4">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="mb-3">
            <label class="form-label">نام کاربری</label>
            <input asp-for="Input.Username" class="form-control" autocomplete="username" />
        </div>

        <div class="mb-4">
            <label class="form-label">رمز عبور</label>
            <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" />
        </div>

        <button class="app-btn w-100" type="submit">ورود</button>
    </form>
</div>