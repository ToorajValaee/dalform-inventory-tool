@page "{id:int}"
@model InventoryTool.Pages.Admin.Products.EditModel

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">ویرایش کالا</h1>
    <p class="text-muted mb-0">بروزرسانی اطلاعات کالا.</p>
</div>

<div class="app-card">
    <form method="post">
        <input type="hidden" asp-for="Input.Id" />

        <div class="mb-3">
            <label class="form-label">بارکد</label>
            <input asp-for="Input.Code" class="form-control" />
            <span asp-validation-for="Input.Code" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">نام کالا</label>
            <input asp-for="Input.Name" class="form-control" />
            <span asp-validation-for="Input.Name" class="text-danger small"></span>
        </div>

        <div class="form-check form-switch mb-4">
            <input asp-for="Input.IsActive" class="form-check-input" />
            <label asp-for="Input.IsActive" class="form-check-label">فعال</label>
        </div>

        <div class="d-grid gap-2">
            <button class="app-btn" type="submit">ذخیره تغییرات</button>
            <a asp-page="Index" class="app-btn-outline text-center">برگشت</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}