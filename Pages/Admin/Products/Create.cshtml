@page
@model InventoryTool.Pages.Admin.Products.CreateModel

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">افزدون کالا</h1>
    <p class="text-muted mb-0">ثبت کالای جدید.</p>
</div>

<div class="app-card">
    <form method="post">
        <div class="mb-3">
            <label class="form-label">بارکد</label>
            <input asp-for="Input.Code" class="form-control" />
            <span asp-validation-for="Input.Code" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label class="form-label">نام کالا</label>
            <input asp-for="Input.Name" class="form-control" />
            <span asp-validation-for="Input.Name" class="text-danger small"></span>
        </div>

        <div class="d-grid gap-2">
            <button class="app-btn" type="submit">ثبت کالا</button>
            <a asp-page="Index" class="app-btn-outline text-center">انصراف</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}